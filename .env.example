# Plantilla de variables de entorno para el backend
# Copie este archivo como .env o configure las variables en su entorno del sistema

# Configuracion de conexion a Oracle Database
DB_URL=jdbc:oracle:thin:@//localhost:1521/XE
DB_USERNAME=system
DB_PASSWORD=password

# Configuracion de seguridad JWT
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_EXPIRATION_MILLISECONDS=3600000
